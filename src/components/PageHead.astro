---
const { kicker, title } = Astro.props;
---
<header class="ph">
  <div class="wrap">
    {kicker && <p class="kicker">{kicker}</p>}
    <h1>{title}</h1>
    {Astro.slots.has('default') && <p class="lead"><slot /></p>}
  </div>
</header>

<style>
  .ph { padding: clamp(48px, 7vw, 96px) 0 clamp(32px, 4vw, 56px); border-bottom: 1px solid var(--line); margin-bottom: clamp(40px, 5vw, 64px); }
  .ph h1 { max-width: 18ch; font-size: clamp(2.2rem, 5vw, 3.8rem); }
  .ph .lead { margin: 0; }
</style>
