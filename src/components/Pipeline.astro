---
// « De la donnée brute au résultat » : l'illustration change au fil du défilement.
const steps = [
  { k: 'Collecter', t: 'Des données qui arrivent propres', p: 'Formulaires KoboToolbox ou ODK avec contrôles de saisie : plages de valeurs, champs obligatoires, sauts conditionnels. Les erreurs sont bloquées sur le terrain, pas découvertes trois mois plus tard.' },
  { k: 'Nettoyer', t: 'Une base vérifiée, ligne par ligne', p: 'Doublons, valeurs impossibles, codages incohérents, données manquantes : chaque correction est tracée dans un journal que vous recevez avec la base.' },
  { k: 'Analyser', t: 'La méthode adaptée à la question', p: 'Tests, régressions, analyse de survie : le choix est justifié par vos objectifs et la nature des variables, puis expliqué en langage clair.' },
  { k: 'Restituer', t: 'Des résultats prêts à servir', p: 'Tableaux et figures aux normes, section « Résultats » rédigée, ou tableau de bord en ligne pour suivre vos indicateurs dans le temps.' },
];
---
<section class="pipe section">
  <div class="wrap">
    <div class="pipe__head">
      <p class="kicker">Notre façon de travailler</p>
      <h2>De la donnée brute au résultat, sans rupture</h2>
    </div>
    <div class="pipe__grid">
      <ol class="pipe__steps">
        {steps.map((s, i) => (
          <li data-step={i}>
            <span class="pipe__k">{String(i + 1)} · {s.k}</span>
            <h3>{s.t}</h3>
            <p>{s.p}</p>
          </li>
        ))}
      </ol>

      <div class="pipe__stick">
        <figure class="pipe__fig" data-active="0" aria-hidden="true">
          <!-- 0 : brut -->
          <div class="ly ly0">
            <p class="ly__cap">base_terrain_v3_FINAL(2).xlsx</p>
            <table>
              <thead><tr><th>id</th><th>âge</th><th>sexe</th><th>poids</th><th>issue</th></tr></thead>
              <tbody>
                <tr><td>0412</td><td>34</td><td>F</td><td>61</td><td>guéri</td></tr>
                <tr><td>0413</td><td class="bad">345</td><td>féminin</td><td>58</td><td>Guéri</td></tr>
                <tr class="dup"><td>0413</td><td>345</td><td>féminin</td><td>58</td><td>Guéri</td></tr>
                <tr><td>0414</td><td>51</td><td class="bad">2</td><td class="bad"></td><td>décédé</td></tr>
                <tr><td>0415</td><td>28</td><td>M</td><td class="bad">6,8</td><td>gueri</td></tr>
                <tr><td>0416</td><td>47</td><td>m</td><td>74</td><td class="bad">?</td></tr>
              </tbody>
            </table>
            <p class="ly__foot ly__foot--bad">5 anomalies · 1 doublon</p>
          </div>
          <!-- 1 : propre -->
          <div class="ly ly1">
            <p class="ly__cap">base_analyse.csv</p>
            <table>
              <thead><tr><th>id</th><th>âge</th><th>sexe</th><th>poids</th><th>issue</th></tr></thead>
              <tbody>
                <tr><td>0412</td><td>34</td><td>F</td><td>61</td><td>Guérison</td></tr>
                <tr><td>0413</td><td class="ok">34</td><td class="ok">F</td><td>58</td><td class="ok">Guérison</td></tr>
                <tr><td>0414</td><td>51</td><td class="ok">F</td><td class="na">NA</td><td>Décès</td></tr>
                <tr><td>0415</td><td>28</td><td>M</td><td class="ok">68</td><td class="ok">Guérison</td></tr>
                <tr><td>0416</td><td>47</td><td class="ok">M</td><td>74</td><td class="na">NA</td></tr>
              </tbody>
            </table>
            <p class="ly__foot ly__foot--ok">Doublon retiré · 5 corrections tracées</p>
          </div>
          <!-- 2 : analyse -->
          <div class="ly ly2">
            <p class="ly__cap">Tableau 3. Facteurs associés au décès</p>
            <table class="res">
              <thead><tr><th>Facteur</th><th>OR ajusté</th><th>IC 95 %</th><th>p</th></tr></thead>
              <tbody>
                <tr><td>Âge ≥ 50 ans</td><td>2,1</td><td>1,3–3,4</td><td>0,003</td></tr>
                <tr><td>Stade III–IV</td><td>3,8</td><td>2,2–6,5</td><td>&lt; 0,001</td></tr>
                <tr><td>Diabète</td><td>1,9</td><td>1,1–3,2</td><td>0,021</td></tr>
                <tr><td>Tabagisme</td><td>1,6</td><td>0,9–2,8</td><td>0,104</td></tr>
              </tbody>
            </table>
            <p class="ly__foot">Régression logistique, n = 412</p>
          </div>
          <!-- 3 : restitution -->
          <div class="ly ly3">
            <div class="doc">
              <i class="doc__h"></i><i></i><i></i><i class="s"></i>
              <svg viewBox="0 0 120 50"><rect x="8" y="26" width="16" height="22" fill="#1b7fc4"/><rect x="32" y="16" width="16" height="32" fill="#168eb0"/><rect x="56" y="6" width="16" height="42" fill="#0e9a9a"/><rect x="80" y="20" width="16" height="28" fill="#0b3a63"/></svg>
              <i></i><i class="s"></i>
            </div>
            <div class="phone">
              <b>Indicateurs</b>
              <span class="phone__n">83 %</span>
              <span class="phone__l">complétude</span>
              <svg viewBox="0 0 80 30"><path d="M0,26 L13,22 L26,23 L40,15 L53,12 L66,8 L80,4" fill="none" stroke="#45a149" stroke-width="2.5"/></svg>
            </div>
          </div>
        </figure>
        <ol class="pipe__dots">{steps.map((_, i) => <li data-dot={i}></li>)}</ol>
      </div>
    </div>
  </div>
</section>

<script>
  const fig = document.querySelector<HTMLElement>('.pipe__fig');
  const steps = document.querySelectorAll<HTMLElement>('.pipe__steps [data-step]');
  const dots = document.querySelectorAll<HTMLElement>('.pipe__dots [data-dot]');
  if (fig) {
    const set = (n: string) => {
      fig.dataset.active = n;
      steps.forEach((s) => s.classList.toggle('is-active', s.dataset.step === n));
      dots.forEach((d) => d.classList.toggle('is-active', d.dataset.dot === n));
    };
    set('0');
    // Grand écran : l'illustration suit le défilement. Mobile : elle défile seule, et un toucher sur une étape l'affiche.
    const mobile = matchMedia('(max-width: 900px)');
    const io = new IntersectionObserver((entries) => {
      if (mobile.matches) return;
      entries.forEach((e) => { if (e.isIntersecting) set((e.target as HTMLElement).dataset.step!); });
    }, { rootMargin: '-45% 0px -45% 0px' });
    steps.forEach((s) => io.observe(s));

    let paused = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let visible = false;
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; }, { threshold: 0.3 }).observe(fig);
    window.setInterval(() => {
      if (!mobile.matches || paused || !visible) return;
      set(String((Number(fig.dataset.active) + 1) % steps.length));
    }, 3500);
    steps.forEach((s) => s.addEventListener('click', () => {
      if (!mobile.matches) return;
      paused = true;
      set(s.dataset.step!);
    }));
  }
</script>

<style>
  .pipe__head { max-width: 640px; margin-bottom: 40px; }
  .pipe__grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(32px, 6vw, 88px); }
  .pipe__steps { list-style: none; padding: 0; margin: 0; }
  .pipe__steps li { min-height: 58vh; display: flex; flex-direction: column; justify-content: center; padding: 24px 0; opacity: .35; transition: opacity .4s; }
  .pipe__steps li:first-child { min-height: 46vh; justify-content: flex-start; padding-top: 8vh; }
  .pipe__steps li.is-active { opacity: 1; }
  .pipe__k { font-weight: 600; color: var(--teal-700); margin-bottom: 10px; }
  .pipe__steps h3 { font-size: clamp(1.5rem, 2.6vw, 2.1rem); }
  .pipe__steps p { color: var(--muted); max-width: 46ch; font-size: 1.05rem; }

  .pipe__stick { position: sticky; top: 110px; align-self: start; }
  .pipe__fig {
    margin: 0; position: relative; aspect-ratio: 4 / 3.1; container-type: inline-size;
    background: var(--surface); border: 1px solid var(--line); border-radius: 10px; overflow: hidden;
    box-shadow: 0 30px 60px -36px rgba(6, 34, 61, .35);
  }
  .ly { position: absolute; inset: 0; padding: 6cqw 6cqw 5cqw; font-size: clamp(9px, 2.7cqw, 15px); opacity: 0; transform: translateY(10px); transition: opacity .5s, transform .5s; display: flex; flex-direction: column; }
  .pipe__fig[data-active='0'] .ly0, .pipe__fig[data-active='1'] .ly1, .pipe__fig[data-active='2'] .ly2, .pipe__fig[data-active='3'] .ly3 { opacity: 1; transform: none; }
  .ly__cap { font-weight: 600; color: var(--ink); margin: 0 0 3cqw; font-size: .95em; }
  .ly table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
  .ly th { text-align: left; font-weight: 600; color: var(--muted); border-bottom: 2px solid var(--ink); padding: .5em .4em; font-size: .9em; }
  .ly td { padding: .55em .4em; border-bottom: 1px solid #edf1f4; color: var(--text); }
  .ly0 .bad { background: #fde8e4; color: #b42318; font-weight: 600; box-shadow: inset 0 0 0 1px #f4b3a8; }
  .ly0 .dup td { background: #fff5e6; color: #a15c07; text-decoration: line-through; }
  .ly1 .ok { background: var(--teal-50); color: var(--teal-700); font-weight: 600; }
  .ly1 .na { color: var(--muted); font-style: italic; }
  .res td:nth-child(n+2) { text-align: right; } .res th:nth-child(n+2) { text-align: right; }
  .res tr:nth-child(-n+3) td:last-child { color: var(--navy); font-weight: 700; }
  .ly__foot { margin: auto 0 0; padding-top: 3cqw; font-size: .9em; color: var(--muted); }
  .ly__foot--bad { color: #b42318; font-weight: 600; }
  .ly__foot--ok { color: var(--teal-700); font-weight: 600; }

  .ly3 { flex-direction: row; align-items: center; justify-content: center; gap: 6cqw; background: linear-gradient(160deg, #eef3f6, #fff); }
  .doc { width: 44cqw; aspect-ratio: .72; background: #fff; border: 1px solid var(--line); border-radius: 4px; padding: 5cqw 4cqw; display: flex; flex-direction: column; gap: 2cqw; box-shadow: 0 10px 30px -14px rgba(6,34,61,.3); }
  .doc i { display: block; height: 1.4cqw; background: #dfe6ec; border-radius: 1cqw; }
  .doc i.doc__h { height: 2.6cqw; width: 70%; background: var(--navy); }
  .doc i.s { width: 60%; }
  .doc svg { width: 100%; margin: 1cqw 0; }
  .phone { width: 26cqw; aspect-ratio: .5; background: var(--navy-900); border-radius: 4cqw; padding: 5cqw 3cqw; display: flex; flex-direction: column; color: #fff; box-shadow: 0 16px 30px -12px rgba(6,34,61,.5); }
  .phone b { font-size: .8em; color: #9fb2c4; font-weight: 500; }
  .phone__n { font-family: var(--display); font-weight: 800; font-size: 2.1em; margin-top: 3cqw; }
  .phone__l { font-size: .75em; color: #9fb2c4; margin-bottom: auto; }
  .phone svg { width: 100%; }

  .pipe__dots { display: flex; gap: 8px; list-style: none; padding: 0; margin: 16px 0 0; justify-content: center; }
  .pipe__dots li { width: 28px; height: 3px; background: var(--line); transition: background .3s; }
  .pipe__dots li.is-active { background: var(--teal); }

  @media (max-width: 900px) {
    .pipe__grid { grid-template-columns: 1fr; gap: 0; }
    .pipe__stick { position: static; grid-row: 1; padding: 0 0 24px; }
    .pipe__fig { aspect-ratio: 4 / 2.9; max-width: 460px; margin: 0 auto; }
    .pipe__steps li, .pipe__steps li:first-child {
      min-height: 0; justify-content: flex-start; padding: 14px 0 14px 18px; opacity: 1; cursor: pointer;
      border-left: 3px solid var(--line); transition: border-color .3s;
    }
    .pipe__steps li.is-active { border-left-color: var(--teal); }
    .pipe__k { margin-bottom: 4px; }
    .pipe__steps h3 { font-size: 1.25rem; margin-bottom: 4px; }
    .pipe__steps p { font-size: 1rem; margin: 0; }
  }
</style>
