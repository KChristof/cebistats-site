---
// Tableau de bord de démonstration (données simulées, générées dans le navigateur).
const { compact = false } = Astro.props;
---
<div class={`dd ${compact ? 'dd--compact' : ''}`} data-dd>
  <div class="dd__top">
    <div>
      <p class="dd__title">Programme de vaccination · suivi mensuel</p>
      <p class="dd__sub">Démonstration · données simulées</p>
    </div>
    <div class="dd__filters">
      <label>Zone
        <select data-f="zone">
          <option value="all">Toutes les zones</option>
          <option>Zone A</option><option>Zone B</option><option>Zone C</option>
          <option>Zone D</option><option>Zone E</option><option>Zone F</option>
        </select>
      </label>
      <label>Indicateur
        <select data-f="ind">
          <option value="cov">Couverture Penta 3</option>
          <option value="drop">Taux d’abandon Penta 1–3</option>
        </select>
      </label>
      <label>Période
        <select data-f="per">
          <option value="12">12 mois</option>
          <option value="6">6 derniers mois</option>
          <option value="3">3 derniers mois</option>
        </select>
      </label>
    </div>
  </div>

  <div class="dd__kpis">
    <div class="kpi"><span data-k="main">—</span><small data-k="mainl">Couverture moyenne</small></div>
    <div class="kpi"><span data-k="vac">—</span><small>Enfants vaccinés (Penta 3)</small></div>
    <div class="kpi"><span data-k="trend">—</span><small>Évolution sur la période</small></div>
    <div class="kpi"><span data-k="below">—</span><small data-k="belowl">Zones sous l’objectif</small></div>
  </div>

  <div class="dd__charts">
    <div class="dd__panel">
      <p class="dd__ph" data-k="lineT">Évolution mensuelle</p>
      <svg class="dd__line" viewBox="0 0 520 220" role="img" aria-label="Évolution mensuelle de l’indicateur"></svg>
    </div>
    <div class="dd__panel">
      <p class="dd__ph">Comparaison des zones</p>
      <ul class="dd__bars"></ul>
    </div>
  </div>
</div>

<script>
  const MONTHS = ['janv.', 'févr.', 'mars', 'avr.', 'mai', 'juin', 'juil.', 'août', 'sept.', 'oct.', 'nov.', 'déc.'];
  const ZONES = ['Zone A', 'Zone B', 'Zone C', 'Zone D', 'Zone E', 'Zone F'];
  // Générateur pseudo-aléatoire déterministe : mêmes chiffres à chaque visite
  let seed = 7;
  const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
  const base = { 'Zone A': 91, 'Zone B': 86, 'Zone C': 82, 'Zone D': 77, 'Zone E': 71, 'Zone F': 64 };
  const pop = { 'Zone A': 1450, 'Zone B': 1200, 'Zone C': 980, 'Zone D': 1320, 'Zone E': 760, 'Zone F': 640 };
  const data: Record<string, { cov: number; drop: number; vac: number }[]> = {};
  for (const z of ZONES) {
    data[z] = MONTHS.map((_, m) => {
      const cov = Math.min(99, base[z as keyof typeof base] + m * 0.55 - (m >= 6 && m <= 8 ? 4 : 0) + (rnd() - .5) * 6);
      const drop = Math.max(1, (100 - base[z as keyof typeof base]) * 0.42 - m * 0.18 + (rnd() - .5) * 3);
      return { cov, drop, vac: Math.round((pop[z as keyof typeof pop] / 12) * cov / 100) };
    });
  }
  const TARGET = { cov: 90, drop: 10 };
  const nf = (x: number, d = 1) => x.toLocaleString('fr-FR', { minimumFractionDigits: d, maximumFractionDigits: d });

  document.querySelectorAll<HTMLElement>('[data-dd]').forEach((root) => {
    const $ = (s: string) => root.querySelector<HTMLElement>(s)!;
    const f = (k: string) => (root.querySelector(`[data-f="${k}"]`) as HTMLSelectElement).value;

    function render() {
      const zone = f('zone'), ind = f('ind') as 'cov' | 'drop', per = Number(f('per'));
      const from = 12 - per;
      const zs = zone === 'all' ? ZONES : [zone];
      // série mensuelle (moyenne pondérée par la population)
      const series = MONTHS.map((_, m) => {
        const w = zs.reduce((a, z) => a + pop[z as keyof typeof pop], 0);
        return zs.reduce((a, z) => a + data[z][m][ind] * pop[z as keyof typeof pop], 0) / w;
      });
      const win = series.slice(from);
      const mean = win.reduce((a, b) => a + b, 0) / win.length;
      const vac = zs.reduce((a, z) => a + data[z].slice(from).reduce((b, r) => b + r.vac, 0), 0);
      const delta = win[win.length - 1] - win[0];
      const zoneMeans = ZONES.map((z) => ({ z, v: data[z].slice(from).reduce((a, r) => a + r[ind], 0) / per }));
      const below = zoneMeans.filter((r) => ind === 'cov' ? r.v < TARGET.cov : r.v > TARGET.drop).length;

      $('[data-k="main"]').textContent = nf(mean) + ' %';
      $('[data-k="mainl"]').textContent = ind === 'cov' ? 'Couverture moyenne' : 'Abandon moyen';
      $('[data-k="vac"]').textContent = vac.toLocaleString('fr-FR');
      const good = ind === 'cov' ? delta >= 0 : delta <= 0;
      const tr = $('[data-k="trend"]');
      tr.textContent = (delta >= 0 ? '+' : '−') + nf(Math.abs(delta)) + ' pt';
      tr.className = good ? 'up' : 'down';
      $('[data-k="below"]').textContent = `${below} / 6`;
      $('[data-k="belowl"]').textContent = ind === 'cov' ? 'Zones sous l’objectif (90 %)' : 'Zones au-dessus du seuil (10 %)';
      $('[data-k="lineT"]').textContent = `Évolution mensuelle · ${zone === 'all' ? 'toutes zones' : zone}`;

      // Courbe
      const svg = root.querySelector('.dd__line')!;
      const W = 520, H = 220, L = 34, R = 10, Tp = 12, B = 26;
      const lo = ind === 'cov' ? 50 : 0, hi = ind === 'cov' ? 100 : 25;
      const X = (m: number) => L + (m / 11) * (W - L - R);
      const Y = (v: number) => Tp + (1 - (v - lo) / (hi - lo)) * (H - Tp - B);
      const grid = (ind === 'cov' ? [50, 60, 70, 80, 90, 100] : [0, 5, 10, 15, 20, 25])
        .map((v) => `<line x1="${L}" x2="${W - R}" y1="${Y(v)}" y2="${Y(v)}" class="g"/><text x="${L - 6}" y="${Y(v) + 4}" text-anchor="end">${v}</text>`).join('');
      const months = MONTHS.map((m, i) => i % 2 === 0 ? `<text x="${X(i)}" y="${H - 6}" text-anchor="middle">${m}</text>` : '').join('');
      const pts = series.map((v, i) => `${X(i).toFixed(1)},${Y(v).toFixed(1)}`);
      const shade = `<rect x="${X(0)}" width="${X(from) - X(0)}" y="${Tp}" height="${H - Tp - B}" class="off"/>`;
      const tgt = TARGET[ind];
      svg.innerHTML = `${grid}${months}${from > 0 ? shade : ''}
        <line x1="${L}" x2="${W - R}" y1="${Y(tgt)}" y2="${Y(tgt)}" class="tg"/>
        <text x="${W - R}" y="${Y(tgt) - 5}" text-anchor="end" class="tgl">${ind === 'cov' ? 'objectif 90 %' : 'seuil 10 %'}</text>
        <polyline points="${pts.join(' ')}" class="ln" pathLength="1"/>
        ${series.map((v, i) => i >= from ? `<circle cx="${X(i)}" cy="${Y(v)}" r="3.2" class="pt"><title>${MONTHS[i]} : ${nf(v)} %</title></circle>` : '').join('')}`;

      // Barres par zone
      const max = ind === 'cov' ? 100 : 25;
      $('.dd__bars').innerHTML = zoneMeans.map((r) => {
        const bad = ind === 'cov' ? r.v < TARGET.cov : r.v > TARGET.drop;
        const sel = zone === 'all' || zone === r.z;
        return `<li class="${bad ? 'bad' : ''} ${sel ? '' : 'dim'}"><span>${r.z}</span><b><i style="width:${(r.v / max) * 100}%"></i><u style="left:${(TARGET[ind] / max) * 100}%"></u></b><em>${nf(r.v)} %</em></li>`;
      }).join('');
    }
    root.querySelectorAll('select').forEach((s) => s.addEventListener('change', render));
    render();
  });
</script>

<style>
  .dd { background: var(--surface); color: var(--text); border-radius: 10px; border: 1px solid var(--line); padding: clamp(16px, 3vw, 28px); }
  .dd__top { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; flex-wrap: wrap; margin-bottom: 18px; }
  .dd__title { font-family: var(--display); font-stretch: 106%; font-weight: 700; font-size: 1.15rem; color: var(--ink); margin: 0; }
  .dd__sub { margin: 2px 0 0; font-size: .8rem; color: var(--muted); }
  .dd__filters { display: flex; gap: 10px; flex-wrap: wrap; }
  .dd__filters label { display: grid; gap: 3px; font-size: .74rem; font-weight: 600; color: var(--muted); }
  .dd__filters select { font: 500 .88rem var(--sans); color: var(--ink); padding: 7px 28px 7px 10px; border: 1px solid var(--line); border-radius: 4px; background: #fafbfc; }
  .dd__kpis { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: 6px; overflow: hidden; margin-bottom: 18px; }
  .kpi { background: #fafbfc; padding: 14px 16px; display: grid; gap: 2px; }
  .kpi span { font-family: var(--display); font-stretch: 108%; font-weight: 800; font-size: 1.55rem; color: var(--ink); font-variant-numeric: tabular-nums; }
  .kpi span.up { color: #1f7a4a; } .kpi span.down { color: #b42318; }
  .kpi small { font-size: .78rem; color: var(--muted); }
  .dd__charts { display: grid; grid-template-columns: 1.5fr 1fr; gap: 18px; }
  .dd__panel { border: 1px solid var(--line); border-radius: 6px; padding: 14px; min-width: 0; }
  .dd__ph { font-size: .85rem; font-weight: 600; color: var(--ink); margin: 0 0 8px; }
  .dd__line { width: 100%; height: auto; font: 10.5px var(--sans); }
  .dd__line :global(text) { fill: var(--muted); }
  .dd__line :global(.g) { stroke: #edf1f4; }
  .dd__line :global(.off) { fill: #f3f5f7; }
  .dd__line :global(.tg) { stroke: #d9822b; stroke-dasharray: 4 3; }
  .dd__line :global(.tgl) { fill: #a35a12; font-weight: 600; }
  .dd__line :global(.ln) { fill: none; stroke: var(--navy); stroke-width: 2.4; stroke-linejoin: round; vector-effect: non-scaling-stroke; stroke-dasharray: 1; animation: ddraw 1s ease both; }
  .dd__line :global(.pt) { fill: #fff; stroke: var(--navy); stroke-width: 2; }
  @keyframes ddraw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  .dd__bars { list-style: none; margin: 0; padding: 4px 0 0; display: grid; gap: 14px; }
  .dd__bars :global(li) { display: grid; grid-template-columns: 54px 1fr 50px; gap: 10px; align-items: center; font-size: .84rem; transition: opacity .3s; }
  .dd__bars :global(li.dim) { opacity: .35; }
  .dd__bars :global(b) { position: relative; height: 12px; background: #edf1f4; border-radius: 2px; }
  .dd__bars :global(i) { display: block; height: 100%; background: var(--teal); border-radius: 2px; transition: width .6s cubic-bezier(.3,.7,.2,1); }
  .dd__bars :global(li.bad i) { background: #d9822b; }
  .dd__bars :global(u) { position: absolute; top: -3px; bottom: -3px; width: 2px; background: var(--ink); }
  .dd__bars :global(em) { font-style: normal; text-align: right; font-weight: 600; color: var(--ink); font-variant-numeric: tabular-nums; }
  @media (max-width: 860px) {
    .dd__kpis { grid-template-columns: 1fr 1fr; }
    .dd__charts { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) { .kpi span { font-size: 1.3rem; } }
</style>
