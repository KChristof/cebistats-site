---
import { nav, contact } from '../data/site.js';
const path = Astro.url.pathname.replace(/\/$/, '');
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---
<header class="hdr">
  <div class="wrap hdr__in">
    <a href="/" class="brand" aria-label="CEBI Stats, accueil">
      <img src="/logo-cb.svg" alt="" width="38" height="43" />
      <span class="brand__name">CEBI<span>Stats</span></span>
    </a>

    <nav class="nav" id="nav" aria-label="Navigation principale">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
        <li class="nav__ext"><a href={contact.validthese} target="_blank" rel="noopener">ValidThèse</a></li>
      </ul>
      <a href="/contact" class="btn btn--primary nav__cta">Demander un devis</a>
    </nav>

    <button class="burger" aria-expanded="false" aria-controls="nav" aria-label="Ouvrir le menu">
      <span></span><span></span>
    </button>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.burger')!;
  const hdr = document.querySelector('.hdr')!;
  btn.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    btn.setAttribute('aria-label', open ? 'Ouvrir le menu' : 'Fermer le menu');
    hdr.classList.toggle('is-open', !open);
    document.body.style.overflow = open ? '' : 'hidden';
  });
  const onScroll = () => hdr.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  /* Le flou est porté par un pseudo-élément : un backdrop-filter sur .hdr ferait de l'en-tête
     le bloc de référence du menu mobile (position: fixed), qui serait alors réduit à quelques pixels. */
  .hdr { position: sticky; top: 0; z-index: 50; border-bottom: 1px solid transparent; transition: border-color .2s; }
  .hdr::before { content: ''; position: absolute; inset: 0; z-index: -1; background: rgba(245, 247, 248, .9); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); }
  .hdr.is-scrolled { border-bottom-color: var(--line); }
  .hdr__in { display: flex; align-items: center; gap: 24px; height: 74px; }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; flex: none; }
  .brand img { width: 38px; height: auto; }
  .brand__name { font-family: var(--display); font-stretch: 112%; font-weight: 800; font-size: 1.3rem; letter-spacing: -.02em; color: var(--navy); }
  .brand__name span { font-weight: 500; color: var(--teal-700); margin-left: 3px; }

  .nav { margin-left: auto; display: flex; align-items: center; gap: 18px; }
  .nav ul { display: flex; gap: 2px; list-style: none; margin: 0; padding: 0; }
  .nav ul a { display: block; white-space: nowrap; padding: 8px 11px; text-decoration: none; color: var(--text); font-weight: 500; font-size: .95rem; position: relative; }
  .nav ul a:hover { color: var(--navy); }
  .nav ul a[aria-current='page'] { color: var(--navy); font-weight: 600; }
  .nav ul a[aria-current='page']::after { content: ''; position: absolute; left: 11px; right: 11px; bottom: 2px; height: 2px; background: var(--teal); }
  .nav__ext a { color: var(--teal-700) !important; }
  .nav__ext a::after { content: ' ↗'; }
  .nav__cta { padding: 11px 18px; font-size: .93rem; }

  .burger { display: none; margin-left: auto; width: 44px; height: 44px; border: 0; background: none; cursor: pointer; position: relative; }
  .burger span { position: absolute; left: 10px; right: 10px; height: 2px; background: var(--ink); transition: transform .25s, top .25s; }
  .burger span:first-child { top: 17px; }
  .burger span:last-child { top: 25px; }
  .is-open .burger span:first-child { top: 21px; transform: rotate(45deg); }
  .is-open .burger span:last-child { top: 21px; transform: rotate(-45deg); }

  @media (max-width: 1180px) {
    .burger { display: block; }
    .nav {
      position: fixed; inset: 74px 0 0 0; background: var(--bg);
      flex-direction: column; align-items: stretch; gap: 24px; padding: 16px var(--gutter) 32px;
      transform: translateY(-8px); opacity: 0; visibility: hidden; transition: opacity .2s, transform .2s, visibility .2s;
      overflow-y: auto;
    }
    .is-open .nav { transform: none; opacity: 1; visibility: visible; }
    .nav ul { flex-direction: column; }
    .nav ul a { padding: 16px 0; font-family: var(--display); font-stretch: 108%; font-size: 1.5rem; font-weight: 600; color: var(--ink); border-bottom: 1px solid var(--line); }
    .nav ul a[aria-current='page']::after { display: none; }
    .nav ul a[aria-current='page'] { color: var(--teal-700); }
    .nav__cta { padding: 16px; }
  }
</style>
