---
import { contact, nav, services, whatsapp } from '../data/site.js';
const year = new Date().getFullYear();
---
<footer class="ftr">
  <div class="wrap">
    <div class="ftr__cta">
      <h2>Vous avez des données.<br /><span>Parlons de ce qu’elles peuvent dire.</span></h2>
      <div class="btn-row">
        <a class="btn btn--teal" href="/contact">Demander un devis</a>
        <a class="btn btn--light" href={whatsapp()} target="_blank" rel="noopener">WhatsApp</a>
      </div>
    </div>

    <div class="ftr__grid">
      <div class="ftr__about">
        <img src="/logo-cb.svg" alt="" width="44" height="50" class="ftr__logo" />
        <p>Cabinet d’Études Biostatistique &amp; Informatique. Analyse de données de santé, collecte, tableaux de bord et formation, depuis Abidjan.</p>
      </div>
      <div>
        <p class="ftr__h">Services</p>
        <ul>{services.map((s) => <li><a href={`/services#${s.id}`}>{s.title}</a></li>)}</ul>
      </div>
      <div>
        <p class="ftr__h">Le site</p>
        <ul>
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          <li><a href="/contact">Contact</a></li>
          <li><a href={contact.validthese} target="_blank" rel="noopener">ValidThèse ↗</a></li>
        </ul>
      </div>
      <div>
        <p class="ftr__h">Contact</p>
        <ul>
          <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
          <li><a href={`tel:+${contact.phoneIntl}`}>{contact.phoneDisplay}</a></li>
          <li><a href={contact.facebook} target="_blank" rel="noopener">Facebook</a></li>
          <li>{contact.city}</li>
        </ul>
      </div>
    </div>
    <p class="ftr__legal">© {year} CEBI Stats</p>
  </div>
</footer>

<style>
  .ftr { background: var(--navy-900); color: #9fb2c4; padding: 80px 0 32px; font-size: .95rem; }
  .ftr a { color: #dbe6ef; text-decoration: none; }
  .ftr a:hover { color: #fff; text-decoration: underline; }
  .ftr__cta { display: flex; justify-content: space-between; align-items: flex-end; gap: 32px; flex-wrap: wrap; padding-bottom: 64px; border-bottom: 1px solid rgba(255,255,255,.12); }
  .ftr__cta h2 { color: #fff; font-size: clamp(1.8rem, 4vw, 3rem); margin: 0; }
  .ftr__cta h2 span { color: #5fd0cb; }
  .ftr__grid { display: grid; grid-template-columns: 1.5fr 1.2fr 1fr 1.1fr; gap: 40px; padding: 56px 0; }
  .ftr__logo { width: 44px; height: auto; margin-bottom: 16px; background: #fff; border-radius: 50%; padding: 6px 7px; box-sizing: content-box; }
  .ftr__about p { max-width: 34ch; }
  .ftr__h { font-weight: 600; color: #fff; margin-bottom: 14px; }
  .ftr ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 9px; }
  .ftr__legal { margin: 0; padding-top: 24px; border-top: 1px solid rgba(255,255,255,.12); font-size: .85rem; }
  @media (max-width: 900px) { .ftr__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 540px) { .ftr__grid { grid-template-columns: 1fr; gap: 32px; } }
</style>
