---
const { project } = Astro.props;
const meta = [project.place, project.year].filter(Boolean).join(' · ');
---
<article class="pc" data-domain={project.domain}>
  <p class="pc__domain">{project.domain}</p>
  <h3>{project.title}</h3>
  <p class="pc__sum">{project.summary}</p>
  {meta && <p class="pc__meta">{meta}</p>}
  <ul class="tags">{project.methods.map((m: string) => <li>{m}</li>)}</ul>
  {project.repo && <a class="pc__repo" href={project.repo} target="_blank" rel="noopener">Code et données anonymisées ↗</a>}
</article>

<style>
  .pc { background: var(--surface); border-top: 3px solid var(--navy); padding: 22px 22px 24px; display: flex; flex-direction: column; gap: 10px; transition: border-color .2s; }
  .pc:hover { border-top-color: var(--teal); }
  .pc__domain { margin: 0; font-size: .88rem; font-weight: 600; color: var(--teal-700); }
  .pc h3 { margin: 0; font-size: 1.15rem; line-height: 1.3; }
  .pc__sum { margin: 0; color: var(--muted); font-size: .95rem; flex: 1; }
  .pc__meta { margin: 0; font-size: .86rem; color: var(--ink); font-weight: 500; }
  .pc__repo { font-size: .9rem; font-weight: 600; }
</style>
