---
// Figure illustrative (données simulées) : courbes de Kaplan-Meier à deux groupes.
const W = 520, X0 = 58, X1 = 500, Y0 = 24, Y1 = 280, TMAX = 60;
const x = (t: number) => X0 + (t / TMAX) * (X1 - X0);
const ys = (s: number) => Y0 + ((1 - s) / 0.6) * (Y1 - Y0); // axe de 1.0 à 0.4

const A = [[0, 1], [4, .97], [9, .94], [14, .915], [20, .89], [27, .865], [33, .845], [41, .82], [50, .80]];
const B = [[0, 1], [3, .95], [6, .9], [10, .84], [15, .775], [21, .715], [28, .66], [36, .615], [45, .575], [54, .55]];

const stepPath = (pts: number[][]) => {
  let d = `M${x(pts[0][0])},${ys(pts[0][1])}`;
  for (let i = 1; i < pts.length; i++) {
    d += ` H${x(pts[i][0]).toFixed(1)} V${ys(pts[i][1]).toFixed(1)}`;
  }
  return d + ` H${x(TMAX)}`;
};
const band = (pts: number[][], w: (t: number) => number) => {
  const up: string[] = [], lo: string[] = [];
  const all = [...pts, [TMAX, pts[pts.length - 1][1]]];
  for (let i = 0; i < all.length - 1; i++) {
    const [t, s] = all[i], t2 = all[i + 1][0];
    up.push(`${x(t)},${ys(Math.min(1, s + w(t)))}`, `${x(t2)},${ys(Math.min(1, s + w(t)))}`);
    lo.push(`${x(t)},${ys(s - w(t))}`, `${x(t2)},${ys(s - w(t))}`);
  }
  return `M${up.join(' L')} L${lo.reverse().join(' L')} Z`;
};
const censA = [7, 17, 24, 30, 38, 46, 56];
const censB = [8, 13, 25, 33, 40, 49, 58];
const sAt = (pts: number[][], t: number) => pts.filter((p) => p[0] <= t).at(-1)![1];

const yTicks = [1, .9, .8, .7, .6, .5, .4];
const xTicks = [0, 12, 24, 36, 48, 60];
const risk = { A: [124, 112, 98, 81, 63, 41], B: [118, 96, 74, 55, 38, 22] };
---
<figure class="km" aria-label="Exemple de figure : courbes de survie de Kaplan-Meier pour deux groupes de patients (données simulées)">
  <div class="km__head">
    <span class="km__fig">Figure 2</span>
    <span class="km__title">Survie globale selon le groupe de traitement</span>
  </div>
  <svg viewBox={`0 0 ${W} 360`} role="img" aria-hidden="true">
    <g class="km__grid">
      {yTicks.map((t) => (
        <g>
          <line x1={X0} x2={X1} y1={ys(t)} y2={ys(t)} />
          <text x={X0 - 10} y={ys(t) + 4} text-anchor="end">{t.toFixed(1).replace('.', ',')}</text>
        </g>
      ))}
      {xTicks.map((t) => <text x={x(t)} y={Y1 + 20} text-anchor="middle">{t}</text>)}
      <text x={X1} y={Y1 + 36} text-anchor="end" class="km__axis">Temps (mois)</text>
      <text x={X0 - 30} y={Y1 + 36} text-anchor="start" class="km__axis">Effectifs à risque</text>
      <text transform={`translate(14 ${(Y0 + Y1) / 2}) rotate(-90)`} text-anchor="middle" class="km__axis">Probabilité de survie</text>
    </g>
    <path d={band(A, (t) => 0.012 + t * 0.0009)} class="km__band km__band--a" />
    <path d={band(B, (t) => 0.014 + t * 0.0011)} class="km__band km__band--b" />
    <path d={stepPath(B)} class="km__line km__line--b" pathLength="1" />
    <path d={stepPath(A)} class="km__line km__line--a" pathLength="1" />
    {censA.map((t) => <line class="km__cens km__cens--a" x1={x(t)} x2={x(t)} y1={ys(sAt(A, t)) - 5} y2={ys(sAt(A, t)) + 5} />)}
    {censB.map((t) => <line class="km__cens km__cens--b" x1={x(t)} x2={x(t)} y1={ys(sAt(B, t)) - 5} y2={ys(sAt(B, t)) + 5} />)}
    <g class="km__risk">
      <text x={X0 - 22} y={334} text-anchor="end" class="ra">A</text>
      <text x={X0 - 22} y={352} text-anchor="end" class="rb">B</text>
      {risk.A.map((n, i) => <text x={x(xTicks[i])} y={334} text-anchor="middle" class="ra">{n}</text>)}
      {risk.B.map((n, i) => <text x={x(xTicks[i])} y={352} text-anchor="middle" class="rb">{n}</text>)}
    </g>
  </svg>
  <figcaption>
    <span class="km__key"><i class="ka"></i>Groupe A</span>
    <span class="km__key"><i class="kb"></i>Groupe B</span>
    <span class="km__stat">HR = 0,46 [IC 95 % : 0,29–0,73] · log-rank p &lt; 0,001</span>
  </figcaption>
  <p class="km__note">Exemple de livrable · données simulées</p>
</figure>

<style>
  .km { margin: 0; background: var(--surface); border: 1px solid var(--line); border-radius: 18px; padding: 22px 22px 16px; box-shadow: var(--shadow); }
  .km__head { display: flex; gap: 10px; align-items: baseline; margin-bottom: 8px; font-size: .9rem; flex-wrap: wrap; }
  .km__fig { font-family: var(--mono); font-size: .74rem; color: var(--accent-700); text-transform: uppercase; letter-spacing: .06em; }
  .km__title { font-family: var(--serif); font-weight: 600; color: var(--ink); }
  .km svg { width: 100%; height: auto; font-family: var(--mono); }
  .km__grid line { stroke: var(--line); stroke-width: 1; }
  .km__grid text, .km__risk text { font-size: 11px; fill: var(--muted); }
  .km__axis { font-family: var(--sans); font-size: 11.5px !important; }
  .km__risk .ra { fill: var(--brand); }
  .km__risk .rb { fill: var(--accent-700); }
  .km__line { fill: none; stroke-width: 2.6; stroke-linejoin: round; stroke-dasharray: 1; stroke-dashoffset: 0; }
  .km__line--a { stroke: var(--brand); }
  .km__line--b { stroke: var(--accent); }
  .km__band--a { fill: var(--brand); opacity: .09; }
  .km__band--b { fill: var(--accent); opacity: .12; }
  .km__cens { stroke-width: 1.6; }
  .km__cens--a { stroke: var(--brand); }
  .km__cens--b { stroke: var(--accent-700); }
  .js .km__line { animation: draw 1.8s .3s cubic-bezier(.4, 0, .2, 1) both; }
  .js .km__line--b { animation-delay: .5s; }
  .js .km__band, .js .km__cens { animation: fade .6s 1.7s both; }
  @keyframes draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes fade { from { opacity: 0; } }
  figcaption { display: flex; flex-wrap: wrap; gap: 8px 18px; align-items: center; font-size: .85rem; color: var(--text); padding-top: 6px; border-top: 1px solid var(--line); }
  .km__key { display: inline-flex; align-items: center; gap: 7px; }
  .km__key i { width: 18px; height: 3px; border-radius: 2px; }
  .ka { background: var(--brand); } .kb { background: var(--accent); }
  .km__stat { font-family: var(--mono); font-size: .76rem; color: var(--muted); margin-left: auto; }
  .km__note { margin: 8px 0 0; font-size: .74rem; color: var(--muted); font-style: italic; }
  @media (max-width: 520px) { .km__stat { margin-left: 0; } }
</style>
