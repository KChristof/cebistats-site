---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import { contact, services, whatsapp } from '../data/site.js';
---
<Base
  title="Contact et devis gratuit"
  description="Contactez CEBI Stats à Abidjan pour un devis gratuit : analyse statistique de thèse ou d’article, collecte de données, formation. WhatsApp, e-mail ou formulaire."
>
  <PageHead eyebrow="Contact" title="Parlons de votre projet">
    Décrivez votre besoin en quelques lignes. Nous revenons vers vous rapidement avec des questions ou un devis.
  </PageHead>

  <section class="section" style="padding-top:0">
    <div class="wrap contact">
      <form class="card form" id="contact-form" novalidate>
        <div class="form__row">
          <div class="field"><label for="f-nom">Nom et prénom</label><input id="f-nom" name="nom" autocomplete="name" required /></div>
          <div class="field"><label for="f-tel">Téléphone (facultatif)</label><input id="f-tel" name="tel" type="tel" autocomplete="tel" /></div>
        </div>
        <div class="form__row">
          <div class="field">
            <label for="f-type">Type de projet</label>
            <select id="f-type" name="type">
              {services.map((s) => <option value={s.id}>{s.title}</option>)}
              <option value="autre">Autre</option>
            </select>
          </div>
          <div class="field">
            <label for="f-echeance">Échéance (facultatif)</label>
            <input id="f-echeance" name="echeance" placeholder="ex. soutenance en mars" />
          </div>
        </div>
        <div class="field">
          <label for="f-msg">Votre projet</label>
          <textarea id="f-msg" name="message" required placeholder="Type d’étude, objectif, nombre de sujets, état de la base de données…"></textarea>
        </div>
        <p class="form__err" id="form-err" role="alert" hidden>Merci d’indiquer votre nom et de décrire votre projet.</p>
        <div class="btn-row">
          <button class="btn btn--wa" type="submit" data-via="wa">Envoyer par WhatsApp</button>
          <button class="btn btn--ghost" type="submit" data-via="mail">Envoyer par e-mail</button>
        </div>
        <p class="form__note">Le message s’ouvre dans WhatsApp ou dans votre messagerie, prêt à être envoyé. Aucune donnée n’est enregistrée sur ce site.</p>
      </form>

      <aside class="coords">
        <a class="coord" href={whatsapp()} target="_blank" rel="noopener">
          <Icon name="chat" /><span><strong>WhatsApp</strong>{contact.phoneDisplay}</span>
        </a>
        <a class="coord" href={`tel:+${contact.phoneIntl}`}>
          <Icon name="phone" /><span><strong>Téléphone</strong>{contact.phoneDisplay}</span>
        </a>
        <a class="coord" href={`mailto:${contact.email}`}>
          <Icon name="mail" /><span><strong>E-mail</strong>{contact.email}</span>
        </a>
        <div class="coord">
          <Icon name="pin" /><span><strong>Localisation</strong>{contact.city}<br />Accompagnement à distance partout</span>
        </div>
        <div class="coords__tip">
          <p><strong>Pour un devis plus rapide</strong>, préparez si possible&nbsp;:</p>
          <ul>
            <li>votre protocole ou résumé de méthodologie,</li>
            <li>votre base de données (même incomplète),</li>
            <li>votre date limite.</li>
          </ul>
        </div>
      </aside>
    </div>
  </section>
</Base>

<script define:vars={{ phone: contact.phoneIntl, email: contact.email }}>
  const form = document.getElementById('contact-form');
  const err = document.getElementById('form-err');
  const type = new URLSearchParams(location.search).get('type');
  if (type && form.type.querySelector(`option[value="${CSS.escape(type)}"]`)) form.type.value = type;

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const via = e.submitter?.dataset.via || 'wa';
    const nom = form.nom.value.trim(), msg = form.message.value.trim();
    if (!nom || !msg) { err.hidden = false; (nom ? form.message : form.nom).focus(); return; }
    err.hidden = true;
    const typeLabel = form.type.options[form.type.selectedIndex].text;
    const tel = form.tel.value.trim(), ech = form.echeance.value.trim();
    const lines = ['Bonjour CEBI Stats,', '', `Nom : ${nom}`];
    if (tel) lines.push(`Téléphone : ${tel}`);
    lines.push(`Projet : ${typeLabel}`);
    if (ech) lines.push(`Échéance : ${ech}`);
    lines.push('', msg);
    const text = lines.join('\n');
    if (via === 'mail') {
      location.href = `mailto:${email}?subject=${encodeURIComponent('Demande de devis : ' + typeLabel)}&body=${encodeURIComponent(text)}`;
    } else {
      window.open(`https://wa.me/${phone}?text=${encodeURIComponent(text)}`, '_blank', 'noopener');
    }
  });
</script>

<style>
  .contact { display: grid; grid-template-columns: 1.5fr 1fr; gap: 32px; align-items: start; }
  .form { display: grid; gap: 18px; padding: clamp(22px, 4vw, 36px); }
  .form__row { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .form__err { margin: 0; color: #b42318; font-weight: 500; font-size: .95rem; }
  .form__note { margin: 0; font-size: .85rem; color: var(--muted); }
  .coords { display: grid; gap: 10px; }
  .coord { display: flex; gap: 14px; align-items: flex-start; padding: 18px 20px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); text-decoration: none; color: var(--text); }
  a.coord:hover { border-color: var(--brand); color: var(--text); }
  .coord > svg { color: var(--brand); flex: none; margin-top: 2px; }
  .coord span { display: grid; font-size: .95rem; overflow-wrap: anywhere; }
  .coord strong { color: var(--ink); }
  .coords__tip { padding: 20px; border-radius: var(--radius); background: var(--accent-50); font-size: .93rem; margin-top: 6px; }
  .coords__tip p { margin: 0 0 6px; }
  .coords__tip ul { margin: 0; padding-left: 1.1em; }
  @media (max-width: 900px) { .contact { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .form__row { grid-template-columns: 1fr; } .form .btn { flex: 1 1 100%; } }
</style>
