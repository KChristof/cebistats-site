---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}
const { post, posts } = Astro.props;
const { Content } = await render(post);
const fmt = (d: Date) => d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
const others = posts
  .filter((p) => p.id !== post.id)
  .sort((a, b) => Number(b.data.category === post.data.category) - Number(a.data.category === post.data.category) || b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  author: { '@type': 'Organization', name: 'CEBI Stats' },
  publisher: { '@type': 'Organization', name: 'CEBI Stats', logo: { '@type': 'ImageObject', url: 'https://cebistats.com/logo-cb.png' } },
  inLanguage: 'fr',
};
---
<Base title={post.data.title} description={post.data.description} type="article" jsonLd={ld}>
  <article class="wrap article">
    <a class="back" href="/blog">← Tous les articles</a>
    <p class="kicker">{post.data.category}</p>
    <h1>{post.data.title}</h1>
    <p class="meta">{post.data.author} · {fmt(post.data.date)} · {post.data.readTime} de lecture</p>
    <div class="prose">
      <Content />
    </div>

    <aside class="cta">
      <h2>Besoin d’aide pour votre analyse&nbsp;?</h2>
      <p>CEBI Stats vous accompagne de la collecte des données à la rédaction des résultats.</p>
      <div class="btn-row">
        <a class="btn btn--teal" href="/contact">Demander un devis</a>
        <a class="btn btn--light" href="/outils">Outils gratuits</a>
      </div>
    </aside>

    {others.length > 0 && (
      <nav class="others" aria-label="Autres articles">
        <h2>À lire aussi</h2>
        {others.map((o) => <a href={`/blog/${o.id}`}><span>{o.data.category}</span>{o.data.title}</a>)}
      </nav>
    )}
  </article>
</Base>

<style>
  .article { max-width: 800px; padding-top: clamp(32px, 5vw, 64px); padding-bottom: 96px; }
  .back { display: inline-block; margin-bottom: 28px; font-size: .92rem; text-decoration: none; }
  .article h1 { font-size: clamp(2rem, 4.6vw, 3.2rem); }
  .meta { color: var(--muted); font-size: .92rem; padding-bottom: 28px; margin-bottom: 36px; border-bottom: 1px solid var(--line); }
  .prose > :global(p:first-child) { font-size: 1.25rem; line-height: 1.55; color: var(--ink); }
  .cta { margin-top: 64px; padding: clamp(24px, 4vw, 40px); border-radius: 10px; background: var(--navy); color: #c9d8e5; }
  .cta h2 { color: #fff; font-size: 1.6rem; }
  .others { margin-top: 56px; display: grid; }
  .others h2 { font-size: 1.3rem; margin-bottom: 8px; }
  .others a { display: grid; gap: 2px; font-family: var(--display); font-stretch: 104%; font-size: 1.15rem; font-weight: 600; text-decoration: none; padding: 16px 0; border-bottom: 1px solid var(--line); color: var(--ink); }
  .others a span { font-family: var(--sans); font-size: .82rem; font-weight: 600; color: var(--teal-700); }
  .others a:hover { color: var(--navy-700); }
</style>
