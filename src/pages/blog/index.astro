---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base
  title="Blog : guides de biostatistique et de collecte de données"
  description="Guides pratiques en biostatistique, analyse de survie, choix des tests statistiques et collecte de données mobile, pour chercheurs et étudiants en santé."
>
  <PageHead kicker="Blog" title="Guides pratiques pour chercheurs et étudiants">
    Biostatistique, méthodes avancées et outils de collecte, expliqués simplement.
  </PageHead>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="posts">
        {posts.map((p) => (
          <a class="post" href={`/blog/${p.id}`}>
            <div class="post__meta">
              <span class="post__cat">{p.data.category}</span>
              <span>{fmt(p.data.date)} · {p.data.readTime}</span>
            </div>
            <h2>{p.data.title}</h2>
            <p>{p.data.description}</p>
            <span class="more">Lire l’article</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .posts { border-top: 1px solid var(--ink); }
  .post { display: grid; grid-template-columns: 220px 1fr; column-gap: 40px; padding: 32px 0; border-bottom: 1px solid var(--line); text-decoration: none; color: var(--text); }
  .post:hover h2 { color: var(--navy); }
  .post__meta { grid-row: span 3; display: grid; align-content: start; gap: 6px; font-size: .88rem; color: var(--muted); }
  .post__cat { font-weight: 600; color: var(--teal-700); }
  .post h2 { font-size: clamp(1.35rem, 2.4vw, 1.7rem); margin-bottom: 8px; transition: color .2s; }
  .post p { color: var(--muted); max-width: 70ch; margin-bottom: 12px; }
  .post .more { color: var(--navy); font-size: .95rem; }
  @media (max-width: 720px) { .post { grid-template-columns: 1fr; } .post__meta { grid-row: auto; margin-bottom: 8px; } }
</style>
