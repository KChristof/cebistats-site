---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects, whatsapp } from '../data/site.js';
const domains = [...new Set(projects.map((p) => p.domain))];
---
<Base
  title="Réalisations : études en santé en Côte d’Ivoire"
  description="Analyses de survie en oncologie, études pronostiques, enquêtes CAP, études transversales : aperçu des études menées par CEBI Stats dans les CHU et structures de santé de Côte d’Ivoire."
>
  <PageHead eyebrow="Réalisations" title="Des études concrètes, dans des contextes variés">
    Un aperçu des travaux menés avec des médecins, des étudiants et des équipes hospitalières. Les données restent la propriété de nos clients : nous ne présentons que le sujet et les méthodes.
  </PageHead>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="filters" role="group" aria-label="Filtrer par spécialité">
        <button type="button" aria-pressed="true" data-f="*">Toutes <span>{projects.length}</span></button>
        {domains.map((d) => (
          <button type="button" aria-pressed="false" data-f={d}>{d} <span>{projects.filter((p) => p.domain === d).length}</span></button>
        ))}
      </div>
      <div class="grid grid-3" id="projects">
        {projects.map((p) => <ProjectCard project={p} />)}
      </div>

      <div class="similar">
        <p>Vous préparez une étude dans l’un de ces domaines&nbsp;?</p>
        <a class="btn btn--primary" href="/contact">Discuter d’un projet similaire</a>
        <a class="btn btn--ghost" href={whatsapp('Bonjour CEBI Stats, je prépare une étude similaire à vos réalisations :')} target="_blank" rel="noopener">WhatsApp</a>
      </div>
    </div>
  </section>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filters button');
  const cards = document.querySelectorAll<HTMLElement>('#projects [data-domain]');
  buttons.forEach((b) => b.addEventListener('click', () => {
    buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    const f = b.dataset.f;
    cards.forEach((c) => { c.hidden = f !== '*' && c.dataset.domain !== f; });
  }));
</script>

<style>
  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 28px; }
  .filters button { font: 500 .92rem var(--sans); padding: 9px 15px; border-radius: 999px; border: 1px solid var(--line); background: var(--surface); color: var(--ink); cursor: pointer; display: inline-flex; gap: 8px; align-items: center; }
  .filters button span { font-family: var(--mono); font-size: .74rem; color: var(--muted); }
  .filters button:hover { border-color: var(--brand); }
  .filters button[aria-pressed='true'] { background: var(--brand); border-color: var(--brand); color: #fff; }
  .filters button[aria-pressed='true'] span { color: #cfcaf5; }
  #projects [hidden] { display: none; }
  .similar { margin-top: 56px; padding-top: 40px; border-top: 1px solid var(--line); display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; }
  .similar p { font-family: var(--serif); font-size: 1.35rem; color: var(--ink); margin: 0 auto 0 0; }
</style>
