---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects, whatsapp } from '../data/site.js';
const domains = [...new Set(projects.map((p) => p.domain))];
---
<Base
  title="Réalisations : études en santé en Côte d’Ivoire"
  description="Analyses de survie en oncologie, études pronostiques, enquêtes CAP, études transversales : les études menées par CEBI Stats avec des équipes hospitalières et des chercheurs en Côte d’Ivoire."
>
  <PageHead kicker="Réalisations" title="Des études menées avec des équipes de terrain">
    Les données restent la propriété de nos clients. Nous présentons le sujet et les méthodes, jamais les résultats non publiés.
  </PageHead>

  <section class="wrap" style="padding-bottom:96px">
    <div class="filters" role="group" aria-label="Filtrer par spécialité">
      <button type="button" aria-pressed="true" data-f="*">Toutes <span>{projects.length}</span></button>
      {domains.map((d) => (
        <button type="button" aria-pressed="false" data-f={d}>{d} <span>{projects.filter((p) => p.domain === d).length}</span></button>
      ))}
    </div>
    <div class="grid cards" id="projects">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>

    <div class="also">
      <div>
        <h2>Tableaux de bord de suivi</h2>
        <p>Nous concevons aussi des applications de suivi d’enquêtes et d’indicateurs, branchées sur KoboToolbox ou DHIS2.</p>
        <a class="more" href="/tableaux-de-bord">Voir la démonstration →</a>
      </div>
      <div>
        <h2>Un projet similaire&nbsp;?</h2>
        <p>Décrivez-nous votre étude : type, effectif, état des données, échéance.</p>
        <div class="btn-row">
          <a class="btn btn--primary" href="/contact">Demander un devis</a>
          <a class="btn btn--line" href={whatsapp('Bonjour CEBI Stats, je prépare une étude similaire :')} target="_blank" rel="noopener">WhatsApp</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filters button');
  const cards = document.querySelectorAll<HTMLElement>('#projects [data-domain]');
  buttons.forEach((b) => b.addEventListener('click', () => {
    buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    const f = b.dataset.f;
    cards.forEach((c) => { c.hidden = f !== '*' && c.dataset.domain !== f; });
  }));
</script>

<style>
  .filters { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 28px; }
  .filters button { font: 500 .92rem var(--sans); padding: 8px 14px; border-radius: 4px; border: 1px solid var(--line); background: var(--surface); color: var(--ink); cursor: pointer; display: inline-flex; gap: 8px; align-items: center; }
  .filters button span { font-size: .8rem; color: var(--muted); font-variant-numeric: tabular-nums; }
  .filters button:hover { border-color: var(--ink); }
  .filters button[aria-pressed='true'] { background: var(--ink); border-color: var(--ink); color: #fff; }
  .filters button[aria-pressed='true'] span { color: #9fb2c4; }
  .cards { grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); }
  #projects [hidden] { display: none; }
  .also { margin-top: 80px; display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--line); border: 1px solid var(--line); }
  .also > div { background: var(--surface); padding: clamp(24px, 4vw, 40px); }
  .also h2 { font-size: 1.5rem; }
  .also p { color: var(--muted); }
  @media (max-width: 760px) { .also { grid-template-columns: 1fr; } }
</style>
